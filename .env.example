# Copy this file to .env (same folder) and fill in the values you were given. .env is gitignored: never commit it,
# never paste its values into a chat or an AI agent prompt.

# Password of the shared dev database (ask the backend lead; sent privately).
Database__Password=

# Any random string of at least 32 characters; only used to sign the tokens of YOUR container.
Jwt__SigningKey=

# Only needed to upload images (not for the counter-sale flow); leave empty otherwise.
Storage__SecretKey=

# Optional: allow another web origin to call the API (the dev origins http://localhost:5173 and :3000 are already allowed).
# Cors__AllowedOrigins__0=http://localhost:4173
