{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AuthSecurity": {
    "SessionDays": 30,
    "ChallengeMinutes": 10,
    "ResendCooldownSeconds": 60
  },
  "BackgroundJobs": {
    "Enabled": true,
    "ExpireLots": false,
    "DebtReminders": false,
    "InventoryAlerts": false,
    "ReconcilePayments": false,
    "ExpireAuthentication": false
  },
  "Jwt": {
    "Issuer": "AgriSage",
    "Audience": "AgriSage.Clients",
    "AccessTokenMinutes": 60,
    "SigningKey": ""
  }
}
