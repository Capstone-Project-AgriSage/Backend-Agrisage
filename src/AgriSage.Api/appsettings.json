{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "KeyPrefix": "agrisage:production:catalog:v1:",
    "TtlSeconds": 120,
    "TimeoutMilliseconds": 1500
  },
  "AuthSecurity": {
    "SessionDays": 30,
    "ChallengeMinutes": 10,
    "ResendCooldownSeconds": 60
  },
  "BackgroundJobs": {
    "Enabled": true,
    "ExpireLots": false,
    "DebtReminders": true,
    "InventoryAlerts": true,
    "ReconcilePayments": false,
    "ExpireAuthentication": false
  },
  "Jwt": {
    "Issuer": "AgriSage",
    "Audience": "AgriSage.Clients",
    "AccessTokenMinutes": 60,
    "SigningKey": ""
  }
}
