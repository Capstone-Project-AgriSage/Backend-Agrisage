  status varchar(20) [not null, note: 'Enum domain: Success, Failed (CLR names; persisted values in dictionary CHECKs)']
  top_predictions json [null]
  updated_at timestamp [not null]
  Note: '''
Entity: AiInference. Feature: Diagnosis.
  '''
}

