  packaging_name_snapshot varchar(150) [not null]
  price_overridden boolean [not null]
  product_name_snapshot varchar(255) [not null]
  product_packaging_id uuid [not null]
  product_sku_snapshot varchar(50) [not null]
  quantity bigint [not null]
  status varchar(30) [not null, note: 'Enum domain: Pending, PartiallyFulfilled, Fulfilled, Cancelled, PartiallyCancelled (CLR names; persisted values in dictionary CHECKs)']
  store_product_id uuid [not null]
  suggested_unit_price decimal(18,2) [not null]
  unit_price decimal(18,2) [not null]
  updated_at timestamp [not null]
  Note: '''
Entity: OrderItem. Feature: Orders.
  '''
}

Table orders {
  id uuid [pk, not null]
  cancel_reason varchar(1000) [null]
  cancelled_at timestamp [null]
  cancelled_by uuid [null]
  completed_at timestamp [null]
  confirmed_at timestamp [null]
  confirmed_by uuid [null]
  created_at timestamp [not null]
  created_by uuid [not null]
  credit_term_days_snapshot integer [null]
  customer_group_id_snapshot uuid [null]
  customer_name_snapshot varchar(150) [not null]
  customer_phone_snapshot varchar(20) [null]
  customer_type varchar(20) [not null, note: 'Enum domain: Registered, WalkIn (CLR names; persisted values in dictionary CHECKs)']
  deleted_at timestamp [null]
  deleted_by uuid [null]
  delivery_address_line varchar(500) [null]
  delivery_district varchar(150) [null]
  delivery_latitude decimal(10,7) [null]
  delivery_longitude decimal(10,7) [null]
  delivery_province varchar(150) [null]
  delivery_ward varchar(150) [null]
  farmer_profile_id uuid [null]
  fulfillment_type varchar(20) [not null, note: 'Enum domain: Pickup, Delivery (CLR names; persisted values in dictionary CHECKs)']
  note varchar(1000) [null]
  order_number varchar(50) [not null]
  pickup_completed_at timestamp [null]
  pickup_completed_by uuid [null]
  price_list_id_snapshot uuid [null]
  recipient_name_snapshot varchar(150) [null]
  recipient_phone_snapshot varchar(20) [null]
  settlement_type varchar(20) [not null, note: 'Enum domain: FullPayment, Credit (CLR names; persisted values in dictionary CHECKs)']
  source varchar(30) [not null, note: 'Enum domain: FarmerWeb, FarmerMobile, Counter (CLR names; persisted values in dictionary CHECKs)']
  source_address_id uuid [null]
  status varchar(40) [not null, note: 'Enum domain: PendingConfirmation, Confirmed, Preparing, ReadyForFulfillment, PartiallyFulfilled, Completed, Cancelled, PartiallyCancelled (CLR names; persisted values in dictionary CHECKs)']
  store_id uuid [not null]
  subtotal_amount decimal(18,2) [not null]
  total_amount decimal(18,2) [not null]
  updated_at timestamp [not null]
  version bigint [not null, note: 'Optimistic concurrency version']
  indexes {
    (store_id, order_number) [unique]
  }
  Note: '''
Entity: Order. Feature: Orders.
  '''
}

Table payment_allocations {
  id uuid [pk, not null]
  allocated_amount decimal(18,2) [not null]
