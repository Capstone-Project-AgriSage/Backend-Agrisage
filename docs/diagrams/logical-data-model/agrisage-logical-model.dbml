Table active_ingredients {
  id uuid [pk, not null]
  code varchar(50) [null]
  created_at timestamp [not null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  description varchar [null]
  is_active boolean [not null]
  name varchar(200) [not null]
  updated_at timestamp [not null]
  Note: '''
Entity: ActiveIngredient. Feature: Products.
  '''
}

Table agent_reviews {
  id uuid [pk, not null]
  ai_disease_id_snapshot uuid [null]
  comment varchar(2000) [null]
  created_at timestamp [not null]
  decision varchar(30) [not null, note: 'Enum domain: Confirmed, Corrected, Inconclusive (CLR names; persisted values in dictionary CHECKs)']
  deleted_at timestamp [null]
  deleted_by uuid [null]
  diagnosis_case_id uuid [not null]
  final_disease_id uuid [null]
  is_current boolean [not null]
  primary_ai_inference_id uuid [null]
  reviewed_at timestamp [not null]
  reviewer_member_id uuid [not null]
  superseded_at timestamp [null]
  superseded_by_review_id uuid [null]
  updated_at timestamp [not null]
  Note: '''
Entity: AgentReview. Feature: Diagnosis.
Conditional unique: (diagnosis_case_id) WHERE is_current = TRUE AND deleted_at IS NULL
  '''
}

Table ai_inferences {
