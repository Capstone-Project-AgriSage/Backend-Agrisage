  stock_movement_id uuid [not null]
  total_cost_snapshot decimal(20,6) [not null]
  total_cost_value_after decimal(20,6) [null]
  unit_cost_snapshot decimal(20,6) [not null]
  updated_at timestamp [not null]
  Note: '''
Entity: StockMovementItem. Feature: Inventory.
  '''
}

Table stock_movements {
  id uuid [pk, not null]
  created_at timestamp [not null]
  created_by uuid [not null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  delivery_id uuid [null]
  goods_receipt_id uuid [null]
  movement_number varchar(50) [not null]
  movement_type varchar(30) [not null, note: 'Enum domain: StockIn, Sale, ReturnIn, AdjustmentIn, AdjustmentOut, Reversal (CLR names; persisted values in dictionary CHECKs)']
  occurred_at timestamp [not null]
  order_id uuid [null]
  posted_at timestamp [null]
  posted_by uuid [null]
  reason varchar(1000) [null]
  reason_code varchar(50) [null]
  reversal_of_movement_id uuid [null]
  sales_return_id uuid [null]
  status varchar(20) [not null, note: 'Enum domain: Draft, Posted, Reversed, Cancelled (CLR names; persisted values in dictionary CHECKs)']
  stocktake_id uuid [null]
  store_id uuid [not null]
  updated_at timestamp [not null]
  Note: '''
Entity: StockMovement. Feature: Inventory.
  '''
}

Table stocktake_items {
  id uuid [pk, not null]
  counted_at timestamp [null]
  counted_by uuid [null]
  counted_quantity bigint [null]
  created_at timestamp [not null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  difference_cost_value decimal(20,6) [null]
  difference_quantity bigint [null]
  inventory_lot_id uuid [not null]
  note varchar(500) [null]
  reason_code varchar(50) [null]
  snapshot_at timestamp [not null]
  stocktake_id uuid [not null]
  system_quantity_snapshot bigint [not null]
  unit_cost_snapshot decimal(20,6) [null]
  updated_at timestamp [not null]
  indexes {
    (stocktake_id, inventory_lot_id) [unique]
  }
  Note: '''
Entity: StocktakeItem. Feature: Inventory.
  '''
}

Table stocktakes {
  id uuid [pk, not null]
  completed_at timestamp [null]
  completed_by uuid [null]
  created_at timestamp [not null]
  created_by uuid [not null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  note varchar(1000) [null]
  started_at timestamp [null]
  started_by uuid [null]
  status varchar(30) [not null, note: 'Enum domain: Draft, InProgress, Completed, Cancelled (CLR names; persisted values in dictionary CHECKs)']
  stocktake_number varchar(50) [not null]
  store_id uuid [not null]
  updated_at timestamp [not null]
  indexes {
    (store_id, stocktake_number) [unique]
  }
  Note: '''
Entity: Stocktake. Feature: Inventory.
  '''
}

Table store_member_permissions {
  id uuid [pk, not null]
  created_at timestamp [not null]
  is_granted boolean [not null]
  permission_id uuid [not null]
  store_member_id uuid [not null]
  updated_at timestamp [not null]
  indexes {
    (store_member_id, permission_id) [unique]
  }
  Note: '''
Entity: StoreMemberPermission. Feature: Stores.
  '''
}

Table store_members {
  id uuid [pk, not null]
  can_review_ai boolean [not null]
  created_at timestamp [not null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  employee_code varchar(50) [null]
  joined_at date [null]
  left_at date [null]
  status varchar(20) [not null, note: 'Enum domain: Active, Inactive, Left (CLR names; persisted values in dictionary CHECKs)']
  store_id uuid [not null]
  updated_at timestamp [not null]
  user_id uuid [not null]
  version bigint [not null, note: 'Optimistic concurrency version']
  indexes {
    (store_id, user_id) [unique]
  }
  Note: '''
Entity: StoreMember. Feature: Stores.
  '''
}

Table store_products {
  id uuid [pk, not null]
  created_at timestamp [not null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  is_active boolean [not null]
  is_sellable boolean [not null]
  min_stock_level_base bigint [null]
  product_id uuid [not null]
  store_id uuid [not null]
  store_sku varchar(50) [null]
  updated_at timestamp [not null]
  indexes {
    (store_id, product_id) [unique]
  }
  Note: '''
Entity: StoreProduct. Feature: Products.
  '''
}

Table stores {
  id uuid [pk, not null]
  address_line varchar(500) [not null]
  code varchar(30) [not null, unique]
  created_at timestamp [not null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  district varchar(150) [null]
  email varchar(255) [null]
  name varchar(200) [not null]
  phone_number varchar(20) [null]
  province varchar(150) [not null]
  status varchar(20) [not null, note: 'Enum domain: Active, Inactive (CLR names; persisted values in dictionary CHECKs)']
  tax_code varchar(50) [null]
  updated_at timestamp [not null]
  ward varchar(150) [null]
  Note: '''
Entity: Store. Feature: Stores.
  '''
}

Table suppliers {
  id uuid [pk, not null]
  address_line varchar(500) [null]
  code varchar(50) [null]
  contact_person varchar(150) [null]
  created_at timestamp [not null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  district varchar(150) [null]
  email varchar(255) [null]
  is_active boolean [not null]
  name varchar(255) [not null]
  note varchar(1000) [null]
  phone_number varchar(20) [null]
  province varchar(150) [null]
  store_id uuid [not null]
  tax_code varchar(50) [null]
  updated_at timestamp [not null]
  ward varchar(150) [null]
  Note: '''
Entity: Supplier. Feature: Suppliers.
Conditional unique: (store_id, code) WHERE code IS NOT NULL AND deleted_at IS NULL
  '''
}

Table units {
  id uuid [pk, not null]
  code varchar(30) [not null, unique]
  created_at timestamp [not null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  is_active boolean [not null]
  name varchar(100) [not null]
  symbol varchar(20) [null]
  updated_at timestamp [not null]
  Note: '''
Entity: Unit. Feature: Products.
  '''
}

Table user_addresses {
  id uuid [pk, not null]
  address_line varchar(500) [not null]
  address_type varchar(20) [not null, note: 'Enum domain: Home, Farm, Other (CLR names; persisted values in dictionary CHECKs)']
  created_at timestamp [not null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  district varchar(150) [null]
  is_default boolean [not null]
  latitude decimal(10,7) [null]
  longitude decimal(10,7) [null]
  province varchar(150) [not null]
  recipient_name varchar(150) [not null]
  recipient_phone varchar(20) [not null]
  updated_at timestamp [not null]
  user_id uuid [not null]
  ward varchar(150) [null]
  Note: '''
Entity: UserAddress. Feature: Identity.
Conditional unique: (user_id) WHERE is_default AND deleted_at IS NULL
  '''
}

Table users {
  id uuid [pk, not null]
  avatar_url varchar(1000) [null]
  created_at timestamp [not null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  email varchar(255) [null]
  email_verified boolean [not null]
  full_name varchar(150) [not null]
  last_login_at timestamp [null]
  password_hash varchar(500) [not null]
  phone_number varchar(20) [null]
  phone_verified boolean [not null]
  role_id uuid [not null]
  security_version bigint [not null, note: 'Optimistic concurrency version']
  status varchar(30) [not null, note: 'Enum domain: Active, Inactive, Suspended, Locked (CLR names; persisted values in dictionary CHECKs)']
  updated_at timestamp [not null]
  Note: '''
Entity: User. Feature: Identity.
Conditional unique: (phone_number) WHERE deleted_at IS NULL AND phone_number IS NOT NULL
Expression unique: (LOWER(email)) WHERE deleted_at IS NULL AND email IS NOT NULL
  '''
}

