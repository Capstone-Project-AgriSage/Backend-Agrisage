  product_id uuid [not null]
  status varchar(20) [not null]
  unit_id uuid [not null]
  updated_at timestamp [not null]
  Note: '''
Entity: ProductPackaging. Feature: Products.
Conditional unique: (barcode) WHERE barcode IS NOT NULL AND deleted_at IS NULL
Conditional unique: (product_id, unit_id) WHERE deleted_at IS NULL
Conditional unique: (product_id) WHERE is_base_unit AND deleted_at IS NULL
  '''
}

