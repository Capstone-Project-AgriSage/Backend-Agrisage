  deleted_at timestamp [null]
  deleted_by uuid [null]
  last_error_code varchar(100) [null]
  processed_at timestamp [null]
  updated_at timestamp [not null]
  Note: '''
Entity: NotificationOutbox. Feature: Notifications.
  '''
}

Table notifications {
  id uuid [pk, not null]
  created_at timestamp [not null]
  data json [null]
  deduplication_key varchar(200) [null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  message varchar(2000) [not null]
  notification_type varchar(50) [not null]
  read_at timestamp [null]
  status varchar(20) [not null, note: 'Enum domain: Unread, Read, Archived (CLR names; persisted values in dictionary CHECKs)']
  title varchar(255) [not null]
  updated_at timestamp [not null]
  user_id uuid [not null]
  Note: '''
Entity: Notification. Feature: Notifications.
Conditional unique: (user_id, deduplication_key) WHERE deduplication_key IS NOT NULL
  '''
}

Table order_items {
  id uuid [pk, not null]
  base_quantity bigint [not null]
  cancelled_base_quantity bigint [not null]
  conversion_to_base_snapshot bigint [not null]
  created_at timestamp [not null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  fulfilled_base_quantity bigint [not null]
  line_total_amount decimal(18,2) [not null]
  order_id uuid [not null]
  overridden_by uuid [null]
