Table diseases {
  id uuid [pk, not null]
  causes varchar [null]
  code varchar(50) [not null, unique]
  created_at timestamp [not null]
  crop_type varchar(50) [not null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  description varchar [null]
  is_active boolean [not null]
  is_healthy_class boolean [not null]
  name varchar(200) [not null]
  prevention varchar [null]
  scientific_name varchar(255) [null]
  symptoms varchar [null]
  updated_at timestamp [not null]
  Note: '''
Entity: Disease. Feature: Diagnosis.
  '''
}

Table farmer_credit_profiles {
  id uuid [pk, not null]
  approved_at timestamp [not null]
  approved_by uuid [not null]
  created_at timestamp [not null]
  credit_limit decimal(18,2) [not null]
  credit_tier_id uuid [null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  farmer_profile_id uuid [not null]
  note varchar(1000) [null]
  status varchar(20) [not null, note: 'Enum domain: Active, Suspended, Blocked (CLR names; persisted values in dictionary CHECKs)']
  store_id uuid [not null]
  updated_at timestamp [not null]
  version bigint [not null, note: 'Optimistic concurrency version']
  indexes {
    (store_id, farmer_profile_id) [unique]
  }
  Note: '''
Entity: FarmerCreditProfile. Feature: Credit.
  '''
}

Table farmer_profiles {
  id uuid [pk, not null]
  created_at timestamp [not null]
  date_of_birth date [null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  gender varchar(20) [null]
  notes varchar(1000) [null]
  updated_at timestamp [not null]
  user_id uuid [not null, unique]
  Note: '''
Entity: FarmerProfile. Feature: Customers.
  '''
}

Table goods_receipt_items {
  id uuid [pk, not null]
  base_quantity bigint [not null]
  base_unit_cost decimal(20,6) [not null]
  conversion_to_base_snapshot bigint [not null]
  created_at timestamp [not null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  expiry_date date [null]
  goods_receipt_id uuid [not null]
  inventory_lot_id uuid [null]
  line_total_amount decimal(18,2) [not null]
  manufacturing_date date [null]
  note varchar(500) [null]
  product_packaging_id uuid [not null]
  purchase_unit_cost decimal(18,2) [not null]
  received_quantity bigint [not null]
  store_product_id uuid [not null]
  supplier_lot_number varchar(100) [null]
  updated_at timestamp [not null]
  Note: '''
Entity: GoodsReceiptItem. Feature: GoodsReceipts.
  '''
}

Table goods_receipts {
  id uuid [pk, not null]
  cancel_reason varchar(1000) [null]
  cancelled_at timestamp [null]
  cancelled_by uuid [null]
  confirmed_at timestamp [null]
  confirmed_by uuid [null]
  created_at timestamp [not null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  note varchar(1000) [null]
  receipt_number varchar(50) [not null]
  received_at timestamp [not null]
  received_by uuid [not null]
  source_file_name varchar(255) [null]
  source_file_url varchar(1000) [null]
  source_type varchar(20) [not null, note: 'Enum domain: Manual, ExcelTemplate (CLR names; persisted values in dictionary CHECKs)']
  status varchar(20) [not null, note: 'Enum domain: Draft, Confirmed, Cancelled (CLR names; persisted values in dictionary CHECKs)']
  store_id uuid [not null]
  subtotal_amount decimal(18,2) [not null]
  supplier_id uuid [not null]
  supplier_invoice_date date [null]
  supplier_invoice_number varchar(100) [null]
  total_amount decimal(18,2) [not null]
  updated_at timestamp [not null]
  indexes {
    (store_id, receipt_number) [unique]
  }
  Note: '''
Entity: GoodsReceipt. Feature: GoodsReceipts.
  '''
}

Table inventory_lot_balances {
  id uuid [pk, not null]
  created_at timestamp [not null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  inventory_lot_id uuid [not null, unique]
  quantity_on_hand bigint [not null]
  quantity_reserved bigint [not null]
  total_cost_value decimal(20,6) [not null]
  updated_at timestamp [not null]
  version bigint [not null, note: 'Optimistic concurrency version']
  Note: '''
Entity: InventoryLotBalance. Feature: Inventory.
  '''
}

Table inventory_lots {
  id uuid [pk, not null]
  created_at timestamp [not null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  expiry_date date [null]
  lot_number varchar(100) [null]
  manufacturing_date date [null]
  status varchar(30) [not null, note: 'Enum domain: Active, Quarantined, Expired, Blocked, Depleted (CLR names; persisted values in dictionary CHECKs)']
  store_product_id uuid [not null]
  updated_at timestamp [not null]
  Note: '''
Entity: InventoryLot. Feature: Inventory.
Conditional unique: (store_product_id) WHERE lot_number IS NULL AND deleted_at IS NULL
Expression unique: (store_product_id, LOWER(lot_number), expiry_date) WHERE deleted_at IS NULL AND lot_number IS NOT NULL; NULL expiry_date được xem là cùng giá trị
  '''
}

Table inventory_reservation_items {
  id uuid [pk, not null]
  base_quantity_consumed bigint [not null]
  base_quantity_released bigint [not null]
  base_quantity_reserved bigint [not null]
  created_at timestamp [not null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  inventory_lot_id uuid [not null]
  inventory_reservation_id uuid [not null]
  order_item_id uuid [not null]
  updated_at timestamp [not null]
  Note: '''
Entity: InventoryReservationItem. Feature: Inventory.
Conditional unique: (inventory_reservation_id, order_item_id, inventory_lot_id) WHERE deleted_at IS NULL
  '''
}

Table inventory_reservations {
  id uuid [pk, not null]
  created_at timestamp [not null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  order_id uuid [not null]
  release_reason varchar(500) [null]
  released_at timestamp [null]
  released_by uuid [null]
  reserved_at timestamp [not null]
  reserved_by uuid [not null]
  status varchar(30) [not null, note: 'Enum domain: Active, PartiallyConsumed, Consumed, Released, Cancelled (CLR names; persisted values in dictionary CHECKs)']
  store_id uuid [not null]
  updated_at timestamp [not null]
  Note: '''
Entity: InventoryReservation. Feature: Inventory.
Conditional unique: (order_id) WHERE status IN ('ACTIVE', 'PARTIALLY_CONSUMED') AND deleted_at IS NULL
  '''
}

Table notification_outbox {
  id uuid [pk, not null]
  attempts integer [not null]
