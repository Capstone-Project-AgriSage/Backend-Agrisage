}

Table payments {
  id uuid [pk, not null]
  amount decimal(18,2) [not null]
  cancelled_at timestamp [null]
  checkout_url varchar(1500) [null]
  confirmation_source varchar(30) [null, note: 'Enum domain: Staff, PayOsWebhook (CLR names; persisted values in dictionary CHECKs)']
  confirmed_at timestamp [null]
  confirmed_by uuid [null]
  created_at timestamp [not null]
  created_by uuid [null]
  currency varchar(3) [not null]
  deleted_at timestamp [null]
  deleted_by uuid [null]
  failed_at timestamp [null]
  initiated_at timestamp [not null]
  last_reconciliation_attempt_at timestamp [null]
  note varchar(1000) [null]
  order_id uuid [null]
  payer_farmer_profile_id uuid [null]
  payment_context varchar(30) [not null, note: 'Enum domain: OrderPayment, DebtRepayment (CLR names; persisted values in dictionary CHECKs)']
  payment_method varchar(20) [not null, note: 'Enum domain: Cash, PayOs, BankTransfer (CLR names; persisted values in dictionary CHECKs)']
  payment_number varchar(50) [not null]
  provider varchar(30) [null]
  provider_metadata json [null]
  provider_order_code bigint [null]
  provider_payment_link_id varchar(150) [null]
  provider_transaction_id varchar(150) [null]
  status varchar(30) [not null, note: 'Enum domain: Pending, Paid, Failed, Cancelled, PartiallyRefunded, Refunded (CLR names; persisted values in dictionary CHECKs)']
  store_id uuid [not null]
  updated_at timestamp [not null]
  indexes {
    (store_id, payment_number) [unique]
  }
  Note: '''
Entity: Payment. Feature: Payments.
Conditional unique: (provider_order_code) WHERE provider_order_code IS NOT NULL
  '''
}

Table permissions {
