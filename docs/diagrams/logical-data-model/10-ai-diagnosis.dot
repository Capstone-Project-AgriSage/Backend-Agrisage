graph [rankdir=LR, bgcolor="white", pad="0.5", nodesep="0.45", ranksep="1.1", splines=polyline, overlap=false, outputorder=edgesfirst, fontname="Arial", fontsize=20, labelloc=t, label="AgriSage — Chẩn đoán AI và duyệt khuyến nghị\nPK / FK / UQ · ? = nullable · edges: parent cardinality → child cardinality"];
