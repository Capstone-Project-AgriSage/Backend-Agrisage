digraph LDM {
graph [rankdir=LR, bgcolor="white", pad="0.5", nodesep="0.45", ranksep="1.1", splines=polyline, overlap=false, outputorder=edgesfirst, fontname="Arial", fontsize=20, labelloc=t, label="AgriSage — Nội dung, thông báo và nhật ký\nPK / FK / UQ · ? = nullable · edges: parent cardinality → child cardinality"];
