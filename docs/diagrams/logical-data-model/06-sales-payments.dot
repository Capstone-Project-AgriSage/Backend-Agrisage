digraph LDM {
graph [rankdir=LR, bgcolor="white", pad="0.5", nodesep="0.45", ranksep="1.1", splines=polyline, overlap=false, outputorder=edgesfirst, fontname="Arial", fontsize=20, labelloc=t, label="AgriSage — Giỏ hàng, đơn hàng và thanh toán\nPK / FK / UQ · ? = nullable · edges: parent cardinality → child cardinality"];
node [shape=plain, fontname="Arial", fontsize=11];
edge [fontname="Arial", fontsize=9, color="#9daab4", fontcolor="#344b5e", arrowsize=0.6, dir=none, labeldistance=1.7];
