# Template of the API's staging variables (docs/deployment/STAGING.md section 2). Copy it OUTSIDE the repository or into
# the host's secret settings and fill it there. Never commit real values.
ASPNETCORE_ENVIRONMENT=Production
Logging__LogLevel__Microsoft.EntityFrameworkCore=Warning

Database__Host=
Database__Port=5432
Database__Database=
Database__Username=
Database__Password=
Database__SslMode=Require

Jwt__SigningKey=
Cors__AllowedOrigins__0=

Storage__Url=
Storage__SecretKey=
Storage__Bucket=product-images
Storage__DeliveryProofBucket=delivery-proofs
Storage__DiagnosisImageBucket=diagnosis-images

PayOS__ClientId=
PayOS__ApiKey=
PayOS__ChecksumKey=
PayOS__ReturnUrl=
PayOS__CancelUrl=

AiService__BaseUrl=
AiService__ApiKey=

# One-off seed of a new database only (--seed --create-admin); remove them afterwards.
Seed__Store__Code=
Seed__Store__Name=
Seed__Store__AddressLine=
Seed__Store__Province=
AdminBootstrap__Email=
AdminBootstrap__Password=
AdminBootstrap__FullName=
AdminBootstrap__PhoneNumber=
